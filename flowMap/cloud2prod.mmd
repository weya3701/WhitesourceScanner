digraph G {
    fontname="Microsoft JhengHei,Arial";
    label="AP 開發者作業與套件同步流程圖 (橫向架構)";
    labelloc="t";
    fontsize=20;
    rankdir=LR;          // 關鍵修改：改為橫向佈局
    nodesep=0.4;
    ranksep=0.7;
    pad=0.4;
    
    // 預設節點與連線樣式
    node [fontname="Microsoft JhengHei,Arial", shape=box, style="filled,rounded", fillcolor="#f9f9f9", color="#333333", width=2.2];
    edge [fontname="Microsoft JhengHei,Arial", color="#555555", fontsize=10];

    // 1. AP 開發者作業階段 (最左側)
    subgraph cluster_dev_workspace {
        label = "使用者階段: AP 開發者本機 / 專案環境";
        color = "#fff9c4";
        style = "filled";
        fillcolor = "#fffde7";
        
        Pipeline_Run [label="Step 1:\nPipeline 執行啟動", fillcolor="#fff59d"];
        Local_Dir    [label="指定目錄\n[ 專案目錄下 ]", shape=folder, fillcolor="#ffe082"];
        WS_Scanner   [label="Step 2: 呼叫\nWhitesourceScanner\n(帶入參數執行)", fillcolor="#fff59d"];
        Report_Check [label="判斷報告\n是否合規？", shape=diamond, fillcolor="#fff59d"];
        Publish_Feed [label="Step 3:\n發佈套件至 P1 環境", fillcolor="#fff59d"];
        
        // 確保內部步驟橫向排列
        Pipeline_Run -> Local_Dir -> WS_Scanner -> Report_Check;
    }

    // 2. 孤島區 (Packages Agent)
    subgraph cluster_isolated {
        label = "區域: 孤島區";
        color = "#b2dfdb";
        style = "filled";
        fillcolor = "#e0f2f1";
        
        PA [label="Packages Agent\n(負責中轉與執行環境)", fillcolor="#80cbc4", style="filled,bold"];
    }

    // 3. Proxy 伺服器
    Proxy [label="Proxy Server\n(中轉代理)", fillcolor="#eceff1", shape=component];

    // 4. 外部網際網路庫 (最右側上方)
    subgraph cluster_external {
        label = "外部公開套件庫 & 雲端檢測";
        color = "#e0e0e0";
        style = "filled,dashed";
        fillcolor = "#fafafa";
        
        Public_Repos [label="公開套件庫\n(NPM / NuGet / PyPI / Maven)", fillcolor="#ffebee"];
        WS_SaaS      [label="Whitesource SaaS\n(安全評估服務)", fillcolor="#fff3e0"];
    }

    // 5. 內部 ADO 中心 (中右側)
    subgraph cluster_internal {
        label = "地端核心網路";
        color = "#c8e6c9";
        style = "filled";
        fillcolor = "#e8f5e9";
        
        ADO_Feed [label="Azure DevOps Server\n指定 Artifact Feed\n(daado01.tytb.com)", fillcolor="#a5d6a7", style="filled,bold"];
    }

    // 6. P3 環境 (最右側下方)
    subgraph cluster_p3 {
        label = "區域: P3 環境 (無外網)";
        color = "#bbdefb";
        style = "filled";
        fillcolor = "#e3f2fd";
        
        P3_Agent  [label="P3 ADO Sync Agent\n(10.75.142.41)", fillcolor="#90caf9", style="filled,bold"];
        Sync_Tool [label="AzureDevops_Artifact_Sync\n(行內既有同步工具)", fillcolor="#90caf9"];
        
        P3_Agent -> Sync_Tool [style=dashed, arrowhead=none];
    }

    // ==========================================
    // 流程與資料流向連線 (Data Flow)
    
    // 1. 取得套件流程
    Pipeline_Run -> PA [label=" 請求取得套件", color="#0288d1", fontcolor="#0288d1"];
    PA -> Proxy [color="#0288d1"];
    Proxy -> Public_Repos [label=" 下載 gradle/npm/maven", color="#0288d1"];
    Public_Repos -> Local_Dir [label=" 儲存至專案目錄", color="#0288d1", style=dashed];

    // 2. Whitesource 掃描流程
    WS_Scanner -> PA [label=" 執行 Java 掃描", color="#e65100", fontcolor="#e65100"];
    PA -> Proxy [color="#e65100"];
    Proxy -> WS_SaaS [label=" 上傳分析並獲取報告", color="#e65100"];
    WS_SaaS -> Report_Check [label=" 回傳報告結果", color="#e65100", style=dashed];

    // 3. 發佈與同步流程
    Report_Check -> Publish_Feed [label=" [是] 允許發佈"];
    Publish_Feed -> ADO_Feed [label=" 發佈至 P1 Feed", color="#2e7d32", fontcolor="#2e7d32", style=bold];
    
    Sync_Tool -> ADO_Feed [label=" 單向同步套件", color="#1565c0", fontcolor="#1565c0", dir=back, style=bold];
}
